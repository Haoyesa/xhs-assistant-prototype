{
  "name": "heimao-ai-note-assistant",
  "version": "0.5.0",
  "private": true,
  "author": "heimao-ai",
  "type": "module",
  "description": "黑猫智记AI（通用内容创作辅助工具：文案优化、排版设计、敏感词检测、封面素材参考。本地运行，不接入任何平台接口、不自动发布、不批量管账号）。",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dev:license": "node dev-license.mjs",
    "reset:activation": "node scripts/reset-activation.mjs",
    "reset:activation:server": "node scripts/reset-activation.mjs --with-server",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.heimao.aicontent",
    "productName": "黑猫智记AI",
    "icon": "assets/icon.ico",
    "files": [
      "server.js",
      "sensitive-words.mjs",
      "qianfan-scraper.js",
      "image-util.js",
      "feishu.js",
      "cdp-config.json",
      "public/**/*",
      "data/**/*",
      "extension/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "extension/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "黑猫智记AI${version}-setup.exe"
    }
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
